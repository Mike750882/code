# App Store Connect requires separately-sized iPhone screenshots per size
# tier -- it does not scale a larger device's screenshots down to fit a
# smaller slot. "iPhone 17 Pro Max" covers the 6.9" large-display slot;
# "iPhone 17 Pro" covers the 6.1"/6.3" medium-display (Dynamic Island)
# slot. "iPad Pro 13-inch (M5)" covers the 13" iPad slot. If your
# installed Xcode's Simulator runtime names these differently, update the
# strings below to match `xcrun simctl list devicetypes` -- fastlane
# needs an exact name match.
devices([
  "iPhone 17 Pro Max",
  "iPhone 17 Pro",
  "iPad Pro 13-inch (M5)"
])

languages(["en-US"])

scheme("SpellWell")

output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

# Real time-of-day/battery/signal in a screenshot looks unpolished and
# dates the screenshot -- this normalizes the status bar instead.
override_status_bar(true)

# SpellWellUITests seeds its own in-memory demo data on launch
# (-UITestSeedDemoData) rather than depending on anything already on the
# Simulator, so starting from a freshly-erased one each run is safe and
# keeps results consistent.
erase_simulator(true)

concurrent_simulators(false)
